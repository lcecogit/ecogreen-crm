# Supabase — create a project, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required. Cron routes return 401 without a matching Authorization header.
CRON_SECRET=dev-cron-secret

# HMAC secret the six brand websites sign lead posts with.
INTAKE_SIGNING_SECRET=dev-intake-secret

# Leave any provider block empty to run its stub. Every flow works end to end
# with all of them empty — see DECISIONS.md §3.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
WHATSAPP_ACCESS_TOKEN=
